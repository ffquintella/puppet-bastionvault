<%- | String[1] $user | -%>
#!/bin/sh
# Managed by Puppet — bastionvault module.
# Operator helper for the bastionvault service. Wraps the system-level
# unit (which itself proxies to the rootless user service) so members of
# the bastionvault group don't need to remember the systemctl incantations.
set -u

usage() {
  cat <<EOF
Usage: bvault-ctl <command>

Commands:
  status    Report whether the bastionvault service and container are running.
  restart   Restart the bastionvault service.
EOF
}

cmd_status() {
  rc=0

  if /usr/bin/systemctl is-active --quiet bastionvault.service; then
    echo "service:   active"
  else
    echo "service:   inactive"
    rc=1
  fi

  state=$(/usr/bin/sudo -n -u <%= $user %> /usr/bin/podman inspect \
    --format '{{.State.Status}}' bastionvault 2>/dev/null || true)
  if [ -n "$state" ]; then
    echo "container: $state"
    [ "$state" = "running" ] || rc=1
  else
    echo "container: missing"
    rc=1
  fi

  return $rc
}

cmd_restart() {
  if [ "$(id -u)" -eq 0 ]; then
    exec /usr/bin/systemctl restart bastionvault.service
  fi
  exec /usr/bin/sudo -n /usr/bin/systemctl restart bastionvault.service
}

case "${1:-}" in
  status)        shift; cmd_status "$@" ;;
  restart)       shift; cmd_restart "$@" ;;
  ''|-h|--help)  usage ;;
  *)             echo "bvault-ctl: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
