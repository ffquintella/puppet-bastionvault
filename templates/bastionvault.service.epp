<%- | Integer $uid, String[1] $user | -%>
[Unit]
Description=BastionVault (system-level wrapper for the rootless user service)
Documentation=https://github.com/ffquintella/puppet-bastionvault
After=network-online.target user@<%= $uid %>.service
Wants=network-online.target
Requires=user@<%= $uid %>.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemctl --machine=<%= $user %>@.host --user start bastionvault.service
ExecStartPost=/usr/bin/systemctl --machine=<%= $user %>@.host --user is-active bastionvault.service
ExecStop=/usr/bin/systemctl --machine=<%= $user %>@.host --user stop bastionvault.service
ExecReload=/usr/bin/systemctl --machine=<%= $user %>@.host --user reload-or-restart bastionvault.service

[Install]
WantedBy=multi-user.target
