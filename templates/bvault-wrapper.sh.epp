<%- | String[1]    $user,
      Stdlib::Port $listen_port,
| -%>
#!/bin/sh
# Managed by Puppet — bastionvault module.
# Re-exec as the rootless service user so we can talk to that user's Podman
# socket, then run the in-container `bvault` CLI.
#
# The CLI runs INSIDE the bastionvault container via `podman exec`, so it
# sees the container's filesystem and network namespace. Two consequences:
#
#   * Trust anchor: /etc/bvault/tls/server.crt is bind-mounted ro from the
#     host's puppet-managed TLS dir; pass it as --ca-cert.
#   * Address: the serving cert's SANs cover the host's FQDN (+ short
#     hostname + primary IP), NOT 127.0.0.1. So we can't aim at the
#     in-container loopback — TLS would fail with NotValidForName. And the
#     CLI's --tls-server-name flag is currently dead in upstream bvault
#     (parsed but not wired into ureq's TLS config), so we can't override
#     SNI either. The robust path is to send traffic to <fqdn>:<host_port>:
#     pasta routes that back into the container, and the FQDN matches the
#     cert's first SAN.
TTY_FLAG=
if [ -t 0 ] && [ -t 1 ]; then TTY_FLAG=-t; fi

# Inject defaults only if the operator didn't already set them via flag or
# env. Scan once over the args; honor both --flag=value and --flag value
# forms.
inject_addr=1
inject_ca=1
for arg in "$@"; do
  case "$arg" in
    --address|--address=*)              inject_addr=0 ;;
    --ca-cert|--ca-cert=*|--ca-path|--ca-path=*|--tls-skip-verify)
                                        inject_ca=0 ;;
  esac
done
[ -n "${BVAULT_ADDR:-}${VAULT_ADDR:-}" ]                                 && inject_addr=0
[ -n "${VAULT_CACERT:-}${VAULT_CAPATH:-}${VAULT_SKIP_VERIFY:-}" ]        && inject_ca=0

extra=
if [ "$inject_addr" = 1 ]; then
  fqdn=$(hostname -f 2>/dev/null || hostname 2>/dev/null)
  if [ -n "$fqdn" ]; then
    extra="$extra --address=https://$fqdn:<%= $listen_port %>"
  else
    # Fallback if hostname resolution is broken on this box.
    extra="$extra --address=https://127.0.0.1:<%= $listen_port %> --tls-skip-verify"
  fi
fi
[ "$inject_ca" = 1 ] && extra="$extra --ca-cert=/etc/bvault/tls/server.crt"

# Move to a directory the target user can read, otherwise sudo inherits the
# caller's cwd (e.g. /root) and the rootless user fails to chdir into it.
cd / || exit 1
# shellcheck disable=SC2086  # $extra is intentionally word-split
exec /usr/bin/sudo -n -u <%= $user %> /usr/bin/podman exec -i $TTY_FLAG bastionvault bvault "$@" $extra
