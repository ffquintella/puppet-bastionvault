<%- | String[1]    $user,
      Stdlib::Port $service_port,
      String       $passthrough_env,
      Stdlib::Absolutepath $hsm_out_dir,
| -%>
#!/bin/sh
# Managed by Puppet — bastionvault module.
# Re-exec as the rootless service user so we can talk to that user's Podman
# socket, then run the in-container `bvault` CLI.
#
# The CLI runs INSIDE the bastionvault container via `podman exec`, so it
# sees the container's filesystem and network namespace:
#
#   * Trust anchor: /etc/bvault/tls/server.crt is bind-mounted ro from the
#     host's puppet-managed TLS dir; pass it as --ca-cert.
#   * Address: the in-container server listens on :$service_port. Under
#     the default host-networking mode the container shares the host
#     netns, so this `podman exec` lands on the same loopback the server
#     binds. Under the legacy pasta/slirp4netns modes pasta is configured
#     without host-loopback / map-gw, so neither the host's loopback nor
#     the FQDN routes back into the container netns — but the exec runs
#     inside that netns, so the container's own loopback at :$service_port
#     is reachable in both cases.
#   * SAN mismatch: the serving cert is issued for the host FQDN, not for
#     127.0.0.1. We pass the FQDN as --tls-server-name so rustls verifies
#     against the SAN while the connection still lands on loopback
#     (requires bvault >= 0.8.3 — older CLIs accept the flag but never
#     plumb it through, falling back to the SAN-vs-loopback error).
#   * Token persistence: bvault >= 0.8.6 writes the token issued by
#     `bvault login` to $BVAULT_TOKEN_FILE on success and reads it back
#     on subsequent invocations when --client-token / VAULT_TOKEN are
#     unset. We point it at /etc/bvault/cli-tokens/<host-user>.token, a
#     bind-mounted directory backed by $cli_token_dir on the host, so
#     the token survives across container restarts and across podman
#     exec invocations.
#   * $service_port (= bastionvault::service_port) is the port the
#     in-container listener binds: $listen_port under host networking,
#     $container_port under pasta/slirp4netns. The exec always targets
#     the container's loopback on that port.
#   * Output files: the container filesystem is ephemeral, so a `--out PATH`
#     given to a local command is lost on restart. The host directory
#     <%= $hsm_out_dir %> (bastionvault::hsm_out_dir, owner bastionvault,
#     0750) is bind-mounted at /hsm-out; use e.g.
#         bvault operator hsm provision --connector http://127.0.0.1:12345 \
#                --out /hsm-out/hsm-a.json
#     and the bundle appears on the host as <%= $hsm_out_dir %>/hsm-a.json.
#   * Terminal flags: stdin a pipe/file -> `-i`; stdin and stdout a tty -> `-i -t`;
#     stdin a tty but stdout not (`bvault ... | grep`) -> neither. A bare `-i`
#     there leaves the exec reading the tty from a background group: SIGTTIN
#     stops it, Ctrl+C cannot reach it and later `podman exec` calls queue.
STDIN_FLAG=-i
TTY_FLAG=
if [ -t 0 ]; then
  if [ -t 1 ]; then TTY_FLAG=-t; else STDIN_FLAG=; fi
fi

# Inject defaults only if the operator didn't already set them via flag or
# env. Scan once over the args; honor both --flag=value and --flag value
# forms.
inject_addr=1
inject_ca=1
inject_sni=1
for arg in "$@"; do
  case "$arg" in
    --address|--address=*)              inject_addr=0 ;;
    --ca-cert|--ca-cert=*|--ca-path|--ca-path=*|--tls-skip-verify)
                                        inject_ca=0 ;;
    --tls-server-name|--tls-server-name=*)
                                        inject_sni=0 ;;
  esac
done

# The injected flags are subcommand-scoped in bvault >= 0.8.7; appending them
# when the operator ran `bvault` bare, `bvault --help`, or `bvault --version`
# makes clap reject the line with "unexpected argument '--address' found".
# Skip injection unless we can see a subcommand on the command line.
case "${1:-}" in
  ''|-h|--help|-V|--version|help)
    inject_addr=0; inject_ca=0; inject_sni=0 ;;
esac

# LOCAL commands never talk to the server, so their clap structs do NOT
# accept --address/--ca-cert/--tls-server-name ("unexpected argument
# '--address' found"). Injection is OFF for every command path listed here,
# including any deeper subcommand/leaf below it. To add a local command,
# append its path to LOCAL_COMMANDS: words joined by ':', entries separated by
# spaces. Everything not listed keeps the default (inject), because the
# default HTTP-using commands (operator init, operator hsm status|members|
# bootstrap|node|repair|recover, login, ...) need the flags.
#   server                 runs the server process itself
#   hsm-gateway            local HSM gateway process
#   operator:hsm:provision talks to the yubihsm-connector, not the server
#   operator:cloud-target  local cloud-target tooling
LOCAL_COMMANDS="server hsm-gateway operator:hsm:provision operator:cloud-target"
_lc_path=""
_lc_n=0
for _arg in "$@"; do
  case "$_arg" in -*) continue ;; esac
  _lc_path="${_lc_path:+$_lc_path:}$_arg"
  case " $LOCAL_COMMANDS " in
    *" $_lc_path "*) inject_addr=0; inject_ca=0; inject_sni=0; break ;;
  esac
  _lc_n=$((_lc_n + 1))
  [ "$_lc_n" -ge 3 ] && break
done
unset _lc_path _lc_n _arg

# bvault has nested command groups (operator/cluster/auth/policy/secrets/
# exchange/rustion at the top, plus `rustion master`, `rustion target`,
# `operator cloud-target`, `operator hsm` one level down) whose group structs do NOT
# accept the HTTP flags — only their leaf subcommands do. So `bvault
# operator` alone, or `bvault rustion master` alone, fails with
# "unexpected argument '--address' found" when we append the flags.
# Walk the user's positional args and skip injection when we land on a
# group without descending to a leaf.
_walk_depth=0
_walk_group=""
_walk_skip=0
for _arg in "$@"; do
  case "$_arg" in -*) continue ;; esac
  case "$_walk_depth" in
    0)
      case "$_arg" in
        operator|cluster|auth|policy|secrets|exchange|rustion)
          _walk_depth=1; _walk_group="$_arg" ;;
        *) _walk_skip=2; break ;;
      esac ;;
    1)
      case "$_walk_group" in
        rustion)
          case "$_arg" in
            master|target) _walk_depth=2 ;;
            *)             _walk_skip=2; break ;;
          esac ;;
        operator)
          case "$_arg" in
            cloud-target|hsm) _walk_depth=2 ;;
            *)            _walk_skip=2; break ;;
          esac ;;
        *) _walk_skip=2; break ;;
      esac ;;
    *) _walk_skip=2; break ;;
  esac
done
# _walk_skip stays 0 only when the loop ended *inside* a group (no leaf
# was seen) — in that case suppress injection.
if [ "$_walk_skip" -eq 0 ] && [ "$_walk_depth" -ge 1 ]; then
  inject_addr=0; inject_ca=0; inject_sni=0
fi
unset _walk_depth _walk_group _walk_skip _arg
[ -n "${BVAULT_ADDR:-}${VAULT_ADDR:-}" ]                                 && inject_addr=0
[ -n "${VAULT_CACERT:-}${VAULT_CAPATH:-}${VAULT_SKIP_VERIFY:-}" ]        && inject_ca=0
[ -n "${VAULT_TLS_SERVER_NAME:-}" ]                                      && inject_sni=0

: "<%= $service_port %>"

extra=
[ "$inject_addr" = 1 ] && extra="$extra --address=https://127.0.0.1:<%= $service_port %>"
[ "$inject_ca"   = 1 ] && extra="$extra --ca-cert=/etc/bvault/tls/server.crt"
if [ "$inject_sni" = 1 ] && [ "$inject_addr" = 1 ]; then
  fqdn=$(hostname -f 2>/dev/null || hostname 2>/dev/null)
  [ -n "$fqdn" ] && extra="$extra --tls-server-name=$fqdn"
fi

# Derive the per-host-user token-helper path. SUDO_USER is set by sudo
# when reachable, LOGNAME otherwise; fall back to "anon" if neither is
# defined (e.g. service contexts).
caller=${SUDO_USER:-${LOGNAME:-${USER:-anon}}}
token_file=/etc/bvault/cli-tokens/${caller}.token

# Always set BVAULT_TOKEN_FILE so the on-disk token helper works even without
# env wiring (it is a path, not a secret, so it stays as NAME=value).
podman_env="--env BVAULT_TOKEN_FILE=${token_file}"
[ -n "${BVAULT_TLS_DEBUG:-}" ]  && podman_env="$podman_env --env BVAULT_TLS_DEBUG=$BVAULT_TLS_DEBUG"

# Secrets travel BY NAME ONLY: `podman exec --env NAME` copies NAME from
# podman's own environment, and `sudo --preserve-env=NAME` carries it across
# the user switch, so the value never shows up in argv (`ps`) or logs.
# Forwarded when the caller has exported them:
#   * VAULT_TOKEN, BVAULT_TOKEN  an operator-supplied token is honored in the
#                                container (the token helper file still works).
#   * bastionvault::cli_passthrough_env (Puppet-managed list, default none),
#     e.g. HSM_ADMIN_PW_A / HSM_FACTORY_PW for `--admin-password env:NAME`,
#     `--factory-password env:NAME`, `--admin hsm-a=env:NAME` on
#     `operator hsm provision|bootstrap|node add|repair`.
# printenv only reports whether the variable is set (value goes to /dev/null).
preserve=
for _v in VAULT_TOKEN BVAULT_TOKEN <%= $passthrough_env %>; do
  if printenv "$_v" >/dev/null 2>&1; then
    podman_env="$podman_env --env $_v"
    preserve="${preserve:+$preserve,}$_v"
  fi
done
unset _v
sudo_env=
[ -n "$preserve" ] && sudo_env="--preserve-env=$preserve"

# Move to a directory the target user can read, otherwise sudo inherits the
# caller's cwd (e.g. /root) and the rootless user fails to chdir into it.
cd / || exit 1
# shellcheck disable=SC2086  # $extra, $podman_env and $sudo_env are intentionally word-split
exec /usr/bin/sudo -n $sudo_env -u <%= $user %> /usr/bin/podman exec $STDIN_FLAG $TTY_FLAG $podman_env bastionvault bvault "$@" $extra
