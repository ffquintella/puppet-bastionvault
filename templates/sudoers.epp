<%- | String[1] $user, String[1] $group | -%>
# Managed by Puppet — bastionvault module.
# Allow members of <%= $group %> to invoke the in-container `bvault` CLI as
# the rootless service user, without a password. The wrapper at
# /usr/local/bin/bvault is the only intended entry point.
%<%= $group %> ALL=(<%= $user %>) NOPASSWD: /usr/bin/podman exec -i bastionvault bvault *, /usr/bin/podman exec -i -t bastionvault bvault *, /usr/bin/podman inspect --format * bastionvault
# Allow `bvault-ctl restart` to drive the system-level wrapper unit as root.
%<%= $group %> ALL=(root) NOPASSWD: /usr/bin/systemctl restart bastionvault.service
Defaults!/usr/bin/podman !requiretty
Defaults!/usr/bin/systemctl !requiretty
