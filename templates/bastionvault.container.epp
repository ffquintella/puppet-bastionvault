<%- | String[1]            $image_ref,
      Integer[0]           $container_uid,
      Integer[0]           $container_gid,
      Enum['host', 'pasta', 'slirp4netns'] $network_mode,
      Stdlib::Port         $listen_port,
      Stdlib::Port         $container_port,
      Enum['single', 'ha'] $mode,
      Stdlib::Port         $raft_port,
      Stdlib::Port         $internal_api_port,
      Stdlib::Absolutepath $config_dir,
      Stdlib::Absolutepath $tls_dir,
      Stdlib::Absolutepath $data_dir,
      Stdlib::Absolutepath $log_dir,
      Stdlib::Absolutepath $backup_dir,
      Stdlib::Absolutepath $cli_token_dir,
      Boolean              $mount_host_ca_bundle,
      Stdlib::Absolutepath $host_ca_bundle_effective,
      String[1]            $log_level,
      Optional[Stdlib::Absolutepath] $plugin_runtime_dir,
      Optional[Stdlib::Absolutepath] $hsm_env_file,
| -%>
[Unit]
Description=BastionVault server (rootless, managed by Puppet)
Wants=network-online.target
After=network-online.target

[Container]
Image=<%= $image_ref %>
ContainerName=bastionvault
# Map the in-container runtime UID/GID to the host's bastionvault user so the
# bind-mounted config and data directories (owned by bastionvault on the host)
# are readable/writable from inside the container.
UserNS=keep-id:uid=<%= $container_uid %>,gid=<%= $container_gid %>
<%- if $network_mode == 'host' { -%>
# Host networking: the container shares the host network namespace. There is no
# pasta/slirp4netns user-mode translation layer, so the passt flow-table socket
# leak that exhausts the ephemeral port range under long-lived HA Raft/hiqlite
# peer connections cannot occur, and the server can reach host-local services
# (e.g. ferrogate) directly over loopback. The listener binds $listen_port on
# the host directly, so no PublishPort mapping is needed (and PublishPort is
# incompatible with Network=host).
Network=host
<%- } else { -%>
Network=<%= $network_mode %>
PublishPort=<%= $listen_port %>:<%= $container_port %>
<%- if $mode == 'ha' { -%>
PublishPort=<%= $raft_port %>:<%= $raft_port %>
PublishPort=<%= $internal_api_port %>:<%= $internal_api_port %>
<%- } -%>
<%- } -%>
Volume=<%= $config_dir %>/config.hcl:/etc/bvault/config.hcl:ro,Z
Volume=<%= $tls_dir %>:/etc/bvault/tls:ro,Z
Volume=<%= $data_dir %>:/var/lib/bvault/data:Z
Volume=<%= $log_dir %>:/var/log/bvault:Z
Volume=<%= $backup_dir %>:/backups:Z
# Per-host-user CLI token helper directory. The wrapper sets
# $BVAULT_TOKEN_FILE=/etc/bvault/cli-tokens/<user>.token so `bvault login`
# persists its issued token here (writable from inside the container) and
# subsequent `bvault <cmd>` invocations read it back.
Volume=<%= $cli_token_dir %>:/etc/bvault/cli-tokens:Z
<%- if $mount_host_ca_bundle { -%>
# Host CA trust bundle (auto-detected). Mounted read-only at both the EL
# canonical path and the Debian-style path so the in-container TLS stack
# trusts the same roots as the host (corporate CAs from update-ca-trust, etc).
# `:z` (lowercase) shares the SELinux label since the bundle is read by other
# host processes; we must not relabel it exclusively to this container.
Volume=<%= $host_ca_bundle_effective %>:/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem:ro,z
Volume=<%= $host_ca_bundle_effective %>:/etc/ssl/certs/ca-certificates.crt:ro,z
<%- } -%>
Environment=RUST_LOG=<%= $log_level %>
<%- if $plugin_runtime_dir { -%>
# Staging dir the process-plugin runtime execs plugin binaries from. Set here as
# well as in config.hcl so the runtime honours it even before config is parsed;
# the env var takes precedence. It resolves to a subdir of the data bind mount
# (<%= $plugin_runtime_dir %>), which the container's non-root uid can write to
# and which is exec-allowed — unlike /tmp (often noexec) or the image's own
# root-owned /var/lib/bvault layer. The server creates the subdir on first use.
Environment=BV_PLUGIN_RUNTIME_DIR=<%= $plugin_runtime_dir %>
<%- } -%>
<%- if $hsm_env_file { -%>
# YubiHSM auth password (BASTIONVAULT_HSM_PASSWORD), kept out of this unit and
# out of config.hcl. Written 0600 by bastionvault::config and loaded by the
# rootless service user at container start.
EnvironmentFile=<%= $hsm_env_file %>
<%- } -%>

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
