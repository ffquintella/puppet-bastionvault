#!/usr/bin/env bash
# bvault-hsm-pki — generate the TLS material for the BastionVault HSM link
# (CA, gateway server certificates, node client certificates) on a TRUSTED
# WORKSTATION. Puppet only installs the finished files on the servers
# (bastionvault::hsm_link_files), so every node gets byte-identical material
# from one CA. The CA private key (ca.key) never leaves this machine.
#
# What the BastionVault HSM link (bv-hsm-link/src/tls.rs) requires:
#   * TLS 1.3, PEM files, ECDSA P-256 keys here (PKCS#8/SEC1 both accepted).
#   * ONE CA shared by both sides: gateway `client_ca_file` and the relay's
#     trust root are the same ca.pem.
#   * Gateway cert (EKU serverAuth): SAN must equal the host in the member's
#     `gateway = "https://<host>:8250"` URL (DNS name or IP).
#   * Node cert (EKU clientAuth): a DNS SAN exactly equal to the entry in the
#     gateway's `allowed_clients` (the node_id). CN, URI and IP SANs do not count.
#
# Validity (enforced, not just defaulted):
#   CA    >= 20 years  (default 7300 days)
#   certs >= 5 years   (default 1830 days)
#
# Usage:
#   bvault-hsm-pki [-d DIR] init-ca
#   bvault-hsm-pki [-d DIR] gateway NAME SAN [SAN...]   e.g. gateway hsm-a segbo1fpr0004.fgv.br
#   bvault-hsm-pki [-d DIR] node NAME                    e.g. node segdc1fpr0005.fgv.br
#   bvault-hsm-pki [-d DIR] verify
#   bvault-hsm-pki [-d DIR] hiera SERVER_SHORTNAME FILE [FILE...]
#       prints a Hiera snippet (bastionvault::hsm_link_files) for one server;
#       e.g. hiera x ca.pem hsm-a.pem hsm-a.key segbo1fpr0004.fgv.br.pem segbo1fpr0004.fgv.br.key
#       The snippet contains PRIVATE KEYS: pipe it through eyaml (or keep the
#       data file encrypted) before committing.
#
# SAN items: a bare token is a DNS name unless it parses as an IPv4/IPv6
# address; "DNS:x" / "IP:x" prefixes are passed through unchanged.
#
# DIR defaults to ./hsm-link (or $BVAULT_PKI_DIR). Output files:
#   ca.key (0600, keep offline)  ca.pem  <name>.key (0600)  <name>.pem
set -euo pipefail
umask 077

CA_MIN_DAYS=7300     # 20 years
CERT_MIN_DAYS=1826   # 5 years incl. one leap day
CA_DAYS="${BVAULT_PKI_CA_DAYS:-7300}"
CERT_DAYS="${BVAULT_PKI_CERT_DAYS:-1830}"
WARN_DAYS="${BVAULT_PKI_WARN_DAYS:-90}"
DIR="${BVAULT_PKI_DIR:-hsm-link}"

die() { echo "bvault-hsm-pki: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"; }
need openssl

while getopts ':d:' opt; do
  case "$opt" in
    d) DIR="$OPTARG" ;;
    *) die "unknown option -$OPTARG" ;;
  esac
done
shift $((OPTIND - 1))
cmd="${1:-}"; [ $# -gt 0 ] && shift

[[ "$CA_DAYS"   =~ ^[0-9]+$ ]] || die "BVAULT_PKI_CA_DAYS must be an integer"
[[ "$CERT_DAYS" =~ ^[0-9]+$ ]] || die "BVAULT_PKI_CERT_DAYS must be an integer"

safe_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid name '$1' (use letters, digits, . _ -)"; }

# cert_ext FILE "Extension Name" — body of one X509v3 extension, parsed from
# -text because LibreSSL (macOS) has no `x509 -ext`.
cert_ext() {
  openssl x509 -in "$1" -noout -text |
    awk -v n="X509v3 $2:" 'index($0,n){f=1;next} f&&/^ +X509v3 /{f=0} f&&/^ {0,12}[A-Z][a-z]+ [A-Za-z]+:/&&!/^ {16}/{f=0} f{print}'
}

is_ip() {
  [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || [[ "$1" == *:* && "$1" =~ ^[0-9A-Fa-f:]+$ ]]
}

san_item() {
  case "$1" in
    DNS:*|IP:*) printf '%s' "$1" ;;
    *) if is_ip "$1"; then printf 'IP:%s' "$1"; else printf 'DNS:%s' "$1"; fi ;;
  esac
}

new_key() { openssl ecparam -genkey -name prime256v1 -noout -out "$1"; chmod 600 "$1"; }

# issue NAME SAN-LIST EKU
issue() {
  local name="$1" san="$2" eku="$3" tmp
  [ "$CERT_DAYS" -ge "$CERT_MIN_DAYS" ] || die "certificate validity must be >= $CERT_MIN_DAYS days (5 years); got $CERT_DAYS"
  [ -f "$DIR/ca.key" ] && [ -f "$DIR/ca.pem" ] || die "no CA in $DIR — run: bvault-hsm-pki -d $DIR init-ca"
  [ ! -e "$DIR/$name.key" ] && [ ! -e "$DIR/$name.pem" ] || die "$DIR/$name.{key,pem} already exist; refusing to overwrite"
  tmp="$(mktemp -d)"
  new_key "$DIR/$name.key"
  openssl req -new -key "$DIR/$name.key" -subj "/CN=$name" -out "$tmp/req.csr"
  printf 'subjectAltName=%s\nextendedKeyUsage=%s\nbasicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature\n' \
    "$san" "$eku" > "$tmp/ext"
  openssl x509 -req -in "$tmp/req.csr" -CA "$DIR/ca.pem" -CAkey "$DIR/ca.key" \
    -CAcreateserial -sha256 -days "$CERT_DAYS" -extfile "$tmp/ext" -out "$DIR/$name.pem" 2>/dev/null
  chmod 644 "$DIR/$name.pem"
  rm -rf "$tmp"
  echo "issued $DIR/$name.pem  ($eku, $san, ${CERT_DAYS}d)"
}

cmd_init_ca() {
  [ "$CA_DAYS" -ge "$CA_MIN_DAYS" ] || die "CA validity must be >= $CA_MIN_DAYS days (20 years); got $CA_DAYS"
  mkdir -p "$DIR"; chmod 700 "$DIR"
  [ ! -e "$DIR/ca.key" ] && [ ! -e "$DIR/ca.pem" ] || die "CA already exists in $DIR; refusing to overwrite"
  local tmp; tmp="$(mktemp -d)"
  new_key "$DIR/ca.key"
  openssl req -new -key "$DIR/ca.key" -subj "/CN=bastionvault-hsm-link-ca" -out "$tmp/ca.csr"
  printf 'basicConstraints=critical,CA:TRUE,pathlen:0\nkeyUsage=critical,keyCertSign,cRLSign\nsubjectKeyIdentifier=hash\n' > "$tmp/ext"
  openssl x509 -req -in "$tmp/ca.csr" -signkey "$DIR/ca.key" -sha256 -days "$CA_DAYS" \
    -extfile "$tmp/ext" -out "$DIR/ca.pem" 2>/dev/null
  chmod 644 "$DIR/ca.pem"
  rm -rf "$tmp"
  echo "created $DIR/ca.pem (${CA_DAYS}d) and $DIR/ca.key — keep ca.key OFFLINE, never copy it to a server"
}

cmd_gateway() {
  [ $# -ge 2 ] || die "usage: gateway NAME SAN [SAN...]"
  local name="$1"; shift; safe_name "$name"
  local san="" s
  for s in "$@"; do san="${san:+$san,}$(san_item "$s")"; done
  issue "$name" "$san" serverAuth
}

cmd_node() {
  [ $# -eq 1 ] || die "usage: node NAME   (NAME is the node_id / allowed_clients entry, used as DNS SAN)"
  safe_name "$1"
  issue "$1" "DNS:$1" clientAuth
}

cmd_verify() {
  [ -f "$DIR/ca.pem" ] || die "no $DIR/ca.pem"
  local rc=0 f name eku san kind remain
  # CA sanity: it must be a CA and outlive the leaf minimum comfortably.
  openssl x509 -in "$DIR/ca.pem" -noout -text | grep -q 'CA:TRUE' || { echo "FAIL ca.pem: not a CA"; rc=1; }
  openssl x509 -in "$DIR/ca.pem" -noout -checkend $((CA_MIN_DAYS * 86400 - 3 * 86400)) >/dev/null \
    || { echo "WARN ca.pem: less than ~20y remaining"; }
  shopt -s nullglob
  for f in "$DIR"/*.pem; do
    name="$(basename "$f" .pem)"; [ "$name" = ca ] && continue
    kind=""; eku="$(cert_ext "$f" "Extended Key Usage" | tr -d '\n')"
    case "$eku" in
      *"TLS Web Server Authentication"*) kind=serverAuth ;;
      *"TLS Web Client Authentication"*) kind=clientAuth ;;
    esac
    [ -n "$kind" ] || { echo "FAIL $name.pem: no serverAuth/clientAuth EKU"; rc=1; continue; }
    if ! openssl verify -CAfile "$DIR/ca.pem" -purpose "$([ $kind = serverAuth ] && echo sslserver || echo sslclient)" "$f" >/dev/null 2>&1; then
      echo "FAIL $name.pem: does not verify against ca.pem"; rc=1; continue
    fi
    if [ -f "$DIR/$name.key" ]; then
      if [ "$(openssl x509 -in "$f" -noout -pubkey)" != "$(openssl pkey -in "$DIR/$name.key" -pubout 2>/dev/null)" ]; then
        echo "FAIL $name.pem: private key $name.key does not match the certificate"; rc=1; continue
      fi
    else
      echo "NOTE $name.pem: no $name.key here (key match not checked)"
    fi
    if [ "$kind" = clientAuth ] && ! cert_ext "$f" "Subject Alternative Name" | grep -q 'DNS:'; then
      echo "FAIL $name.pem: clientAuth cert needs a DNS SAN (the allowed_clients entry)"; rc=1; continue
    fi
    san="$(cert_ext "$f" "Subject Alternative Name" | tr -d '\n' | sed 's/^ *//')"
    if ! openssl x509 -in "$f" -noout -checkend $((WARN_DAYS * 86400)) >/dev/null; then
      echo "FAIL $name.pem: expires within ${WARN_DAYS} days"; rc=1; continue
    fi
    remain="$(openssl x509 -in "$f" -noout -enddate | cut -d= -f2)"
    echo "OK   $name.pem ($kind; $san; notAfter=$remain)"
  done
  return $rc
}

cmd_hiera() {
  [ $# -ge 2 ] || die "usage: hiera SERVER FILE [FILE...]"
  local server="$1"; shift
  local f
  for f in "$@"; do
    [ "$f" = ca.key ] && die "refusing to emit ca.key — it must never reach a server"
    [ -f "$DIR/$f" ] || die "no such file: $DIR/$f"
  done
  echo "# HSM link material for $server — contains PRIVATE KEYS: encrypt with eyaml before committing."
  echo "bastionvault::hsm_link_files:"
  for f in "$@"; do
    echo "  '$f':"
    echo "    content: |"
    sed 's/^/      /' "$DIR/$f"
  done
}

case "$cmd" in
  init-ca) cmd_init_ca "$@" ;;
  gateway) cmd_gateway "$@" ;;
  node)    cmd_node "$@" ;;
  verify)  cmd_verify "$@" ;;
  hiera)   cmd_hiera "$@" ;;
  *) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; [ -z "$cmd" ] || exit 2 ;;
esac
